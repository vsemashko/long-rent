# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.production and fill in the values
# NEVER commit .env.production to Git!
# ============================================================================

# ============================================================================
# DATABASE (Supabase PostgreSQL)
# ============================================================================
# Get from: Supabase Project Settings > Database > Connection String
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ============================================================================
# REDIS CACHE (Upstash)
# ============================================================================
# Get from: Upstash Console > Redis > Details
REDIS_URL="rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379"

# ============================================================================
# AUTHENTICATION SECRETS
# ============================================================================
# Generate with: openssl rand -hex 64
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_64_CHAR_STRING"
JWT_REFRESH_SECRET="REPLACE_WITH_SECURE_RANDOM_64_CHAR_STRING"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================================================
# APPLICATION URLS
# ============================================================================
NODE_ENV="production"
API_URL="https://api.homemore.pl"
WEB_URL="https://homemore.pl"
PORT=3001

# ============================================================================
# EMAIL SERVICE (SendGrid or AWS SES)
# ============================================================================
EMAIL_FROM="noreply@homemore.pl"

# Option 1: SendGrid (Recommended for MVP)
SENDGRID_API_KEY="SG.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Option 2: AWS SES (Alternative)
# AWS_SES_REGION="eu-central-1"
# AWS_SES_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
# AWS_SES_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ============================================================================
# SMS SERVICE (Twilio) - OPTIONAL for MVP
# ============================================================================
# TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# TWILIO_AUTH_TOKEN="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# TWILIO_PHONE_NUMBER="+48123456789"

# ============================================================================
# FILE STORAGE (AWS S3)
# ============================================================================
# Get from: AWS IAM > Users > Security Credentials
AWS_S3_REGION="eu-central-1"
AWS_S3_BUCKET="homemore-uploads-production"
AWS_S3_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_S3_SECRET_ACCESS_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ============================================================================
# GOOGLE MAPS API
# ============================================================================
# Get from: Google Cloud Console > APIs & Services > Credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
GOOGLE_PLACES_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ============================================================================
# PAYMENT PROCESSING (Stripe)
# ============================================================================
# Get from: Stripe Dashboard > Developers > API Keys
STRIPE_PUBLIC_KEY="pk_live_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY"
STRIPE_SECRET_KEY="sk_live_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET"

# ============================================================================
# ANALYTICS
# ============================================================================
# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ============================================================================
# ERROR TRACKING (Sentry)
# ============================================================================
# Get from: Sentry Project Settings > Client Keys (DSN)
SENTRY_DSN="https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@XXXXXX.ingest.sentry.io/XXXXXXX"
NEXT_PUBLIC_SENTRY_DSN="https://XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX@XXXXXX.ingest.sentry.io/XXXXXXX"

# ============================================================================
# CUSTOMER SUPPORT (Optional)
# ============================================================================
# NEXT_PUBLIC_INTERCOM_APP_ID="XXXXXXXX"

# ============================================================================
# SECURITY & RATE LIMITING
# ============================================================================
# Generate with: openssl rand -hex 64
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_64_CHAR_STRING"

# Rate limiting (requests per window)
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="15m"

# CORS (production domains only)
CORS_ORIGIN="https://homemore.pl,https://www.homemore.pl"

# ============================================================================
# OPTIONAL SERVICES (Can defer to post-MVP)
# ============================================================================
# ID Verification (Onfido)
# ONFIDO_API_TOKEN="test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# ONFIDO_WEBHOOK_TOKEN="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# QES Digital Signing (Certum)
# CERTUM_API_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
# CERTUM_API_URL="https://api.certum.pl"
