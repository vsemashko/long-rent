// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

enum UserRole {
  TENANT
  LANDLORD
  BOTH
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          UserRole @default(TENANT)
  emailVerified Boolean  @default(false) @map("email_verified")
  phoneVerified Boolean  @default(false) @map("phone_verified")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  profile               Profile?
  ownedProperties       Property[]            @relation("PropertyOwner")
  favorites             PropertyFavorite[]
  sentMessages          Message[]
  conversations         Conversation[]        @relation("ConversationParticipants")
  viewingBookings       Viewing[]             @relation("ViewingTenant")
  applications          RentalApplication[]
  contractsAsLandlord   RentalContract[]      @relation("ContractLandlord")
  contractsAsTenant     RentalContract[]      @relation("ContractTenant")
  paymentsAsPayer       Payment[]             @relation("PaymentPayer")
  paymentsAsPayee       Payment[]             @relation("PaymentPayee")
  reviewsGiven          Review[]              @relation("ReviewReviewer")
  reviewsReceived       Review[]              @relation("ReviewReviewee")
  refreshTokens         RefreshToken[]
  verificationDocuments VerificationDocument[]
  maintenanceIssues     MaintenanceIssue[]

  @@map("users")
}

model Profile {
  id                   String             @id @default(uuid())
  userId               String             @unique @map("user_id")
  firstName            String?            @map("first_name")
  lastName             String?            @map("last_name")
  phone                String?
  avatarUrl            String?            @map("avatar_url")
  bio                  String?            @db.Text
  dateOfBirth          DateTime?          @map("date_of_birth")
  verificationStatus   VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verificationData     Json?              @map("verification_data")
  languagePreference   String             @default("pl") @map("language_preference")
  notificationSettings Json?              @default("{}") @map("notification_settings")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model VerificationDocument {
  id             String             @id @default(uuid())
  userId         String             @map("user_id")
  documentType   String             @map("document_type") // ID, income, employment, ownership
  documentUrl    String             @map("document_url")
  status         VerificationStatus @default(PENDING)
  verifiedAt     DateTime?          @map("verified_at")
  rejectionNote  String?            @map("rejection_note")
  expiresAt      DateTime?          @map("expires_at")
  metadata       Json?
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_documents")
}

// ============================================================================
// PROPERTY MANAGEMENT
// ============================================================================

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  ROOM
  OTHER
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  RENTED
  ARCHIVED
}

model Property {
  id          String         @id @default(uuid())
  landlordId  String         @map("landlord_id")
  title       String
  description String         @db.Text
  propertyType PropertyType  @map("property_type")
  status      PropertyStatus @default(DRAFT)

  // Address (stored as JSON for flexibility)
  address     Json
  // Geolocation (PostGIS geometry point)
  location    Unsupported("geometry(Point, 4326)")?

  // Price
  price       Decimal        @db.Decimal(10, 2)
  currency    String         @default("PLN")
  deposit     Decimal?       @db.Decimal(10, 2)
  utilities   Decimal?       @db.Decimal(10, 2)

  // Property details
  area        Decimal?       @db.Decimal(8, 2) // in square meters
  rooms       Int?
  bedrooms    Int?
  bathrooms   Int?
  floor       Int?
  totalFloors Int?           @map("total_floors")

  // Features and rules (stored as JSON arrays)
  features    Json?          @default("[]")
  amenities   Json?          @default("[]")
  rules       Json?          @default("{}")

  // Metadata
  viewCount   Int            @default(0) @map("view_count")
  availableFrom DateTime?    @map("available_from")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  landlord     User                  @relation("PropertyOwner", fields: [landlordId], references: [id], onDelete: Cascade)
  photos       PropertyPhoto[]
  favorites    PropertyFavorite[]
  viewings     Viewing[]
  applications RentalApplication[]
  contracts    RentalContract[]
  issues       MaintenanceIssue[]

  @@index([landlordId])
  @@index([status])
  @@index([propertyType])
  @@index([price])
  @@map("properties")
}

model PropertyPhoto {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  url        String
  order      Int      @default(0)
  caption    String?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_photos")
}

model PropertyFavorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("property_favorites")
}

// ============================================================================
// MESSAGING
// ============================================================================

model Conversation {
  id         String   @id @default(uuid())
  propertyId String?  @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  participants User[]
  messages     Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String   @db.Text
  attachments    Json?    @default("[]")
  isRead         Boolean  @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ============================================================================
// VIEWINGS & APPLICATIONS
// ============================================================================

enum ViewingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Viewing {
  id          String        @id @default(uuid())
  propertyId  String        @map("property_id")
  tenantId    String        @map("tenant_id")
  scheduledAt DateTime      @map("scheduled_at")
  status      ViewingStatus @default(SCHEDULED)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   User     @relation("ViewingTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
  @@index([scheduledAt])
  @@map("viewings")
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model RentalApplication {
  id              String            @id @default(uuid())
  propertyId      String            @map("property_id")
  tenantId        String            @map("tenant_id")
  status          ApplicationStatus @default(PENDING)
  message         String?           @db.Text
  moveInDate      DateTime?         @map("move_in_date")
  employmentInfo  Json?             @map("employment_info") // Job title, employer, income
  referencesInfo  Json?             @map("references_info") // Previous landlord references
  additionalInfo  Json?             @map("additional_info") // Pets, smoking preferences, etc.
  landlordNotes   String?           @db.Text @map("landlord_notes")
  reviewedAt      DateTime?         @map("reviewed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("rental_applications")
}

// ============================================================================
// CONTRACTS & PAYMENTS
// ============================================================================

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  ACTIVE
  COMPLETED
  TERMINATED
}

model RentalContract {
  id             String         @id @default(uuid())
  propertyId     String         @map("property_id")
  landlordId     String         @map("landlord_id")
  tenantId       String         @map("tenant_id")
  startDate      DateTime       @map("start_date")
  endDate        DateTime?      @map("end_date")
  rentAmount     Decimal        @db.Decimal(10, 2) @map("rent_amount")
  depositAmount  Decimal        @db.Decimal(10, 2) @map("deposit_amount")
  utilitiesAmount Decimal?      @db.Decimal(10, 2) @map("utilities_amount")
  contractUrl    String?        @map("contract_url")
  status         ContractStatus @default(DRAFT)
  signatureData  Json?          @map("signature_data")
  terms          Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relations
  property Property  @relation(fields: [propertyId], references: [id])
  landlord User      @relation("ContractLandlord", fields: [landlordId], references: [id])
  tenant   User      @relation("ContractTenant", fields: [tenantId], references: [id])
  payments Payment[]
  reviews  Review[]

  @@index([propertyId])
  @@index([landlordId])
  @@index([tenantId])
  @@index([status])
  @@map("rental_contracts")
}

enum PaymentType {
  RENT
  DEPOSIT
  UTILITIES
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(uuid())
  contractId        String        @map("contract_id")
  payerId           String        @map("payer_id")
  payeeId           String        @map("payee_id")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("PLN")
  type              PaymentType
  status            PaymentStatus @default(PENDING)
  paymentIntentId   String?       @map("payment_intent_id") // Stripe payment intent ID
  paymentMethodId   String?       @map("payment_method_id")
  metadata          Json?
  failureReason     String?       @map("failure_reason")
  processedAt       DateTime?     @map("processed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  contract RentalContract @relation(fields: [contractId], references: [id])
  payer    User           @relation("PaymentPayer", fields: [payerId], references: [id])
  payee    User           @relation("PaymentPayee", fields: [payeeId], references: [id])

  @@index([contractId])
  @@index([payerId])
  @@index([status])
  @@map("payments")
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id           String   @id @default(uuid())
  contractId   String   @map("contract_id")
  reviewerId   String   @map("reviewer_id")
  revieweeId   String   @map("reviewee_id")
  rating       Int // 1-5 stars
  comment      String?  @db.Text
  isPublic     Boolean  @default(true) @map("is_public")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  contract RentalContract @relation(fields: [contractId], references: [id])
  reviewer User           @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  reviewee User           @relation("ReviewReviewee", fields: [revieweeId], references: [id])

  @@unique([contractId, reviewerId, revieweeId])
  @@index([revieweeId])
  @@map("reviews")
}

// ============================================================================
// MAINTENANCE
// ============================================================================

enum IssueStatus {
  REPORTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model MaintenanceIssue {
  id          String        @id @default(uuid())
  propertyId  String        @map("property_id")
  reportedBy  String        @map("reported_by")
  title       String
  description String        @db.Text
  priority    IssuePriority @default(MEDIUM)
  status      IssueStatus   @default(REPORTED)
  photos      Json?         @default("[]")
  resolvedAt  DateTime?     @map("resolved_at")
  notes       String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reporter User     @relation(fields: [reportedBy], references: [id])

  @@index([propertyId])
  @@index([status])
  @@map("maintenance_issues")
}

// ============================================================================
// AUDIT & LOGS
// ============================================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  changes   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
