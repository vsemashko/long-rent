# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://homemore:homemore_dev_password@localhost:5432/homemore?schema=public"
DATABASE_URL_UNPOOLED="postgresql://homemore:homemore_dev_password@localhost:5432/homemore?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Application
NODE_ENV="development"
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
PORT=3001

# Email
EMAIL_FROM="noreply@homemore.pl"
SENDGRID_API_KEY="your-sendgrid-api-key"
# OR
AWS_SES_REGION="eu-central-1"
AWS_SES_ACCESS_KEY_ID="your-aws-access-key"
AWS_SES_SECRET_ACCESS_KEY="your-aws-secret-key"

# SMS (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+48123456789"

# File Storage (AWS S3)
AWS_S3_REGION="eu-central-1"
AWS_S3_BUCKET="homemore-uploads"
AWS_S3_ACCESS_KEY_ID="your-aws-access-key"
AWS_S3_SECRET_ACCESS_KEY="your-aws-secret-key"

# Maps (Google Maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
GOOGLE_PLACES_API_KEY="your-google-places-api-key"

# Payments (Stripe)
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Verification (Onfido)
ONFIDO_API_TOKEN="your-onfido-api-token"
ONFIDO_WEBHOOK_TOKEN="your-onfido-webhook-token"

# QES (Certum/Szafir)
CERTUM_API_KEY="your-certum-api-key"
CERTUM_API_URL="https://api.certum.pl"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_MIXPANEL_TOKEN="your-mixpanel-token"

# Error Tracking (Sentry)
SENTRY_DSN="your-sentry-dsn"
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn"

# Support (Intercom)
NEXT_PUBLIC_INTERCOM_APP_ID="your-intercom-app-id"

# Rate Limiting
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="15m"

# Session
SESSION_SECRET="your-session-secret-change-in-production"

# CORS
CORS_ORIGIN="http://localhost:3000"
